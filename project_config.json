    "reranker_train": "data/processed/reranker_tune_train.jsonl",
    "reranker_val": "data/processed/reranker_tune_val.jsonl"
  },
  "normalization": {
    "official_source_domain": "mevzuat.gov.tr",
    "valid_quality_flags": [
      "valid_article",
      "short_but_valid"
